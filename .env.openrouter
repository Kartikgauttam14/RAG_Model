#!/usr/bin/env bash
# OpenRouter-free configuration — no credit card required, ~200 req/min for free models.
#
# How to use:
#   cp .env.openrouter .env              # locally
#   render.com > Environment > Add Variable  # one per line
#
# Get a free OpenRouter key: https://openrouter.ai/settings/integrations  (no payment info)
#
# Free models (all are `:free` variants, e.g. meta-llama/llama-3.2-3b-instruct:free):
#   Llama 3.2 3B   — fastest response, adequate for this schema
#   Gemma 2 9B     — better reasoning, slightly slower
#   Mistral 7B     — lightweight alternative
# Pick one and keep the `:free` suffix.

# ─── LLM (answer drafting + planning + verification) ────────────────────────
LLM_PROVIDER=huggingface
HF_INFERENCE_URL=https://openrouter.ai/api/v1
HF_API_MODE=openai
HF_MODEL=meta-llama/llama-3.2-3b-instruct:free
HF_TOKEN=sk-or-v1-USE-YOUR-OWN-OPENROUTER-KEY
LLM_TIMEOUT_SECONDS=30
# Optional per-stage routing (blank = use HF_MODEL). On free tier, use the
# same free model everywhere — no extra cost to route, but larger models cost
# more requests against the ~200 req/min limit.
LLM_DRAFT_MODEL=
LLM_FAST_MODEL=

# ─── Embeddings ─────────────────────────────────────────────────────────────
# Free option still needs a hosted embedding endpoint. OpenRouter does NOT serve
# embeddings, so use one of:
#   Hugging Face inference API (bge-m3): https://api-inference.huggingface.co/models/BAAI/bge-m3
#   sentence-transformers via HF router (with billing-enabled token)
#   Your own HF endpoint
EMBEDDING_PROVIDER=huggingface
EMBEDDING_INFERENCE_URL=https://router.huggingface.co/models/BAAI/bge-m3/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=45
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# ─── Reranker ───────────────────────────────────────────────────────────────
RERANK_PROVIDER=disabled
RERANK_INFERENCE_URL=
RERANK_TIMEOUT_SECONDS=30

# ─── Speech (optional) ──────────────────────────────────────────────────────
STT_PROVIDER=disabled
TTS_PROVIDER=disabled

# ─── Everything below is unchanged from the main .env ───────────────────────
APP_ENV=development
AUTHENTICATION_ENABLED=false
APP_NAME=Mansam RAG
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=development-only-change-this-secret-32-characters

RAG_VECTOR_TOP_K=20
RAG_LEXICAL_TOP_K=20
RERANK_TOP_K=8
RAG_VERIFY_ENABLED=false
RAG_MIN_SCORE=0.25

KEEP_MODEL_WARM=false
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_INLINE=false

MAX_UPLOAD_SIZE_MB=25