APP_ENV=development
AUTHENTICATION_ENABLED=false
APP_NAME=Mansam RAG
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_USER_CONTENT=false

DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
DATABASE_ADMIN_URL=postgresql://rag:rag@postgres:5432/rag
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-use

LLM_PROVIDER=disabled
HF_TOKEN=
HF_MODEL=
# Any OpenAI-compatible /v1/chat/completions base URL works, e.g. the HuggingFace
# router (https://router.huggingface.co) or a local Ollama server (http://127.0.0.1:11434).
HF_INFERENCE_URL=
HF_API_MODE=openai
LLM_TIMEOUT_SECONDS=60
# Optional per-stage routing: LLM_DRAFT_MODEL answers the question, LLM_FAST_MODEL runs
# the planner, the verifier and memory extraction. Both default to HF_MODEL.
LLM_DRAFT_MODEL=
LLM_FAST_MODEL=

EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
EMBEDDING_INFERENCE_URL=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=45

# Reranking is optional; leaving RERANK_INFERENCE_URL empty disables the precision
# stage and retrieval falls back to reciprocal rank fusion alone. The bundled
# `reranker` compose service (BAAI/bge-reranker-v2-m3 on Text Embeddings Inference)
# is reached at http://127.0.0.1:8082/rerank; a URL ending in /rerank is handled as
# TEI, while any other URL is treated as a HuggingFace text-classification endpoint
# expecting `{"inputs": [{"text": ..., "text_pair": ...}]}`. Candidates are sent in
# batches of RERANK_BATCH_SIZE, because a server that caps a request at 32 pairs
# (the Text Embeddings Inference default) answers 413 and the stage is skipped.
RERANK_PROVIDER=disabled
RERANK_MODEL=
RERANK_INFERENCE_URL=
RERANK_TIMEOUT_SECONDS=30
RERANK_BATCH_SIZE=32

# STT_PROVIDER/TTS_PROVIDER: "huggingface" posts raw audio to a hosted HF endpoint,
# "openai" speaks the OpenAI audio API (multipart /v1/audio/transcriptions and JSON
# /v1/audio/speech), which is what a self-hosted whisper/Kokoro server such as the
# bundled `speech` compose service provides. Leave the URLs empty to disable the feature.
STT_PROVIDER=disabled
STT_MODEL=
STT_INFERENCE_URL=
STT_API_KEY=
STT_MIN_CONFIDENCE=0.70
# Optional vocabulary prompt for Whisper, which biases decoding toward these words so
# brand and product names are transcribed as written. Only used by the OpenAI provider.
STT_PROMPT=

TTS_PROVIDER=disabled
TTS_MODEL=
TTS_INFERENCE_URL=
TTS_API_KEY=
TTS_VOICE=default
TTS_SPEED=1.0

OCR_PROVIDER=disabled
OCR_INFERENCE_URL=
OCR_API_KEY=

RAG_VECTOR_TOP_K=20
RAG_LEXICAL_TOP_K=20
RERANK_TOP_K=8
RAG_MIN_SCORE=0.35
RAG_MIN_EVIDENCE=1
RAG_MAX_CONTEXT_CHARS=16000
# Verification is a second generation over the same evidence and roughly doubles the time to an
# answer. false keeps the admission gate, the model's own `grounded` flag and citation
# resolution, and stores the answer with status `verification_skipped`.
RAG_VERIFY_ENABLED=true
# Ollama drops a model after five minutes idle, so the first question after a pause pays a
# reload. Neither keep_alive nor OLLAMA_KEEP_ALIVE is honoured through its OpenAI-compatible
# endpoint, so with this on the API pings the model every few minutes to hold it on the GPU.
KEEP_MODEL_WARM=false
KEEP_WARM_INTERVAL_SECONDS=240
# The planner is an extra generation per question. A short first-turn question needs no
# rewrite, so the deterministic plan is used below this word count; set 0 to always ask
# the model.
PLANNER_LLM_MIN_WORDS=6
CHUNK_TARGET_CHARS=1600
CHUNK_MAX_CHARS=2400
CHUNK_OVERLAP_CHARS=200

MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/markdown,text/html,text/csv,application/json
URL_INGESTION_ENABLED=false
URL_ALLOWED_HOSTS=
URL_INGESTION_MAX_PAGES=25
URL_INGESTION_USER_AGENT=MansamRAG-Ingestion/0.1
# Comma-separated spreadsheet sheet names to skip during extraction. Use this to
# keep internal/operational tabs (changelogs, DB schemas, internal scoring
# rubrics) out of the retrieval index; matched case-insensitively.
INGESTION_EXCLUDED_SHEETS=
# Comma-separated spreadsheet columns that carry authoring/workflow state. A row is
# dropped from the index when one of these columns contains an unpublished marker, so
# assistant drafts pending review are never served as brand knowledge. Only these
# columns are inspected, so unrelated status columns (e.g. Open/Closed) stay intact.
INGESTION_WORKFLOW_COLUMNS=status,state,review status,reviewed by,author
# Case-insensitive markers (matched as substrings) that flag a row as unpublished.
INGESTION_UNPUBLISHED_MARKERS=draft,pending,tbd,todo,wip
RATE_LIMIT_PER_MINUTE=30
MALWARE_SCANNER_COMMAND=

MEMORY_TTL_SECONDS=86400
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_MIN_CONFIDENCE=0.85
# true keeps memory extraction inside the request that asks the question (an extra
# generation plus an embedding call before the caller gets its answer); false runs it
# after the answer is committed.
LONG_TERM_MEMORY_INLINE=true

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
