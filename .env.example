APP_ENV=development
AUTHENTICATION_ENABLED=false
APP_NAME=Mansam RAG
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_USER_CONTENT=false

DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
DATABASE_ADMIN_URL=postgresql://rag:rag@postgres:5432/rag
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-use

LLM_PROVIDER=disabled
HF_TOKEN=
HF_MODEL=
HF_INFERENCE_URL=
HF_API_MODE=openai
LLM_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
EMBEDDING_INFERENCE_URL=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=45

RERANK_PROVIDER=disabled
RERANK_MODEL=
RERANK_INFERENCE_URL=
RERANK_TIMEOUT_SECONDS=30

STT_PROVIDER=disabled
STT_MODEL=
STT_INFERENCE_URL=
STT_API_KEY=
STT_MIN_CONFIDENCE=0.70

TTS_PROVIDER=disabled
TTS_MODEL=
TTS_INFERENCE_URL=
TTS_API_KEY=
TTS_VOICE=default
TTS_SPEED=1.0

OCR_PROVIDER=disabled
OCR_INFERENCE_URL=
OCR_API_KEY=

RAG_VECTOR_TOP_K=20
RAG_LEXICAL_TOP_K=20
RERANK_TOP_K=8
RAG_MIN_SCORE=0.35
RAG_MIN_EVIDENCE=1
RAG_MAX_CONTEXT_CHARS=16000
CHUNK_TARGET_CHARS=1600
CHUNK_MAX_CHARS=2400
CHUNK_OVERLAP_CHARS=200

MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,text/markdown,text/html,text/csv,application/json
URL_INGESTION_ENABLED=false
URL_ALLOWED_HOSTS=
URL_INGESTION_MAX_PAGES=25
URL_INGESTION_USER_AGENT=MansamRAG-Ingestion/0.1
RATE_LIMIT_PER_MINUTE=30
MALWARE_SCANNER_COMMAND=

MEMORY_TTL_SECONDS=86400
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_MIN_CONFIDENCE=0.85

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
